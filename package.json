{
  "name": "saucedemo-automation-suite",
  "version": "1.0.0",
  "description": "Manual test plan, bug reports and Playwright automation for SauceDemo (UI) and Reqres (API)",
  "author": "Anshu Yadav",
  "license": "MIT",
  "scripts": {
    "postinstall": "playwright install chromium chromium-headless-shell",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test tests/ui --headed",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0"
  }
}
